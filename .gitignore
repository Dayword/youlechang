# ====================================================================
#  .gitignore  —  游乐场智能 RAG 问答系统
#  原则：密钥/凭据、本地运行时数据、构建产物、调试残留一律不入库
# ====================================================================

# ---------------------- 密钥 / 凭据（绝对不上传）---------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*secret*.json
*credential*.json

# ---------------------- Python ---------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------- Node / 前端构建产物 ---------------------------
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
*.tsbuildinfo
.*.swc/
.swc/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------- 本地运行时数据 / 数据库 -----------------------
volumes/
logs/
**/logs/
*.log
database/users.db
*.sqlite
*.sqlite3
chat_history/
index/*.pkl
*.pkl
*.pt
*.bin

# --------------- 运行时用户上传内容（含真实用户头像/失物照片）---------
static/avatars/
static/lost_found/
static/uploads/
static/qrcode/
static/favorites/

# ------- 调试残留：_* 探针脚本 / 输出 / 日志 / 截图（根目录 + scripts/）---
#   规则：默认全部排除，下方逐个放行需要保留的文件
#   2026-09-23 起探针归档到 scripts/，规则同步覆盖两层
/_*.py
/_*.out
/_*.log
/_*.json
/_*.txt
/_*.png
/_*.html
/_*_backup_*/
/scripts/_*.py
/scripts/_*.out
/scripts/_*.log
/scripts/_*.json
/scripts/_*.txt
/scripts/_*.png
/scripts/_*.html
/scripts/_*_backup_*/
#   放行：回归验收脚本（去掉 /_* 前缀后重新纳入）
!/_verify_*.py
!/scripts/_verify_*.py
#   放行：业务文档纯文本
!/_thesis_dump.txt
!/_rules_dump.txt
!/scripts/_thesis_dump.txt
!/scripts/_rules_dump.txt
#   再排除：以下脚本含真实用户手机号 / 密钥赋值，任何情况下不入库
/_verify_phone_conflict.py
/_verify_account_identity.py
/scripts/_verify_phone_conflict.py
/scripts/_verify_account_identity.py
/scripts/_probe_combo_planning.py
/scripts/_probe_profile_latency.py
/scripts/_sample_profile_qa.py
/scripts/_dbg_rag_profile.py
/scripts/_mp_login_probe.py
/scripts/_fill_wx_env.py
/scripts/_verify_account_identity.py

# --------------- 一次性迁移脚本的备份产物（含真实用户手机号/消费记录）---
scripts_backup/

