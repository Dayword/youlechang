# ======================================================================
#  环境变量示例
#  用法：复制本文件为 .env，把下面标注 <必填> 的项换成真实值。
#  .env 已被 .gitignore 排除，永远不会进入仓库。
# ======================================================================

DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password    # <必填> 原值已剔除
MYSQL_DATABASE=amusement_rag
REDIS_PASSWORD=your-redis-password    # <必填> 原值已剔除
# ---------- 高德地图 Web 服务（开发/生产分别配置不同 key）----------
AMAP_WEB_SERVICE_KEY=your-amap-web-service-key    # <必填> 原值已剔除
AMAP_DAILY_QUOTA=5000
AMAP_TIMEOUT=5
# ---------- JWT 签名密钥（勿提交仓库） ----------
JWT_SECRET_KEY=<64位随机串，用 python -c "import secrets;print(secrets.token_hex(32))" 生成>    # <必填> 原值已剔除
# ---------- 微信小程序（AppID/Secret 从 mp后台-开发设置获取） ----------
WECHAT_APPID=wxaafcfd19bfea714f
# ⚠️ 下面的 Secret 必须是「上面这个 AppID 自己的」AppSecret
#    （微信公众平台 → 开发 → 开发设置 → AppSecret）。两个不同的 AppID 不能共用一个 Secret，
#    用错会报 40125 invalid appsecret；AppID 与小程序 project.config.json 不一致则报 40029。
WECHAT_SECRET=your-appsecret    # <必填> 原值已剔除
# ---------- 微信支付开关 ----------
# false=未开通(个人主体，下单返回4001提示) / mock=联调(直接发卡) / true=正式(需商户号三件套)
WECHAT_PAY_ENABLED=false
# 开通支付后填写：
# WECHAT_MCHID=
# WECHAT_APIV3_KEY=
# WECHAT_CERT_SERIAL=
# WECHAT_PRIVATE_KEY_PATH=
# WECHAT_PAY_NOTIFY_URL=
LLM_API_KEY=sk-your-llm-api-key    # <必填> 原值已剔除
LLM_ENDPOINT=https://tokenhub.tencentmaas.com/v1
LLM_MODEL=deepseek/deepseek-v4-flash-vision-exp

# 文本模型（RAG生成/改写/校验/工具调用/意图路由）。
# 2026-09-17 二次换型：deepseek/deepseek-flash 的免费额度也已耗尽（402 / 401008，
# logs/app.log 里有 754 条）→ 用户侧问答 500。改用 deepseek-v4-pro。
# ⚠️ 选**带日期快照 -202606**，不要用无日期别名 deepseek-v4-pro：
#   ① 无日期别名历史上最早耗尽额度（deepseek-v4-flash 就是这么挂的），且会被静默重指版本；
#   ② 实测无日期别名三处都最差：流式 TTFT 1.50s（vs 0.93s）、Router 1.75s（几乎顶满超时）。
# 实测（n=15 流式 / n=12 Router）：流式 TTFT 均值 0.93~1.42s、最慢 1.43s；
#   RAG 生成非流式均值 2.28s；空回答 0/15；工具调用正常；关思考参数生效（reasoning_tokens=0）。
LLM_TEXT_MODEL=deepseek-v4-pro-202606

# 意图路由 L2 分类硬超时（秒）。
# ⚠️ 换 v4-pro 后必须同步放宽：Router 实测 1.23s 均值 / 1.43s 最慢，
#    原 1.5s 会把请求全部掐断（实测 12/12 失败）→ L2 路由静默失效、退回纯关键词路由。
#    放宽到 2.5s 后 12/12 成功。仅"带行动标记且关键词全未命中"的问句才走这条（有 1h 缓存），
#    纯知识问答热路径一次 LLM 都不会多花，不影响"检索速度不能变慢"。
ROUTER_TIMEOUT=2.5

# ---------- Docker Compose 项目名（固定，勿删） ----------
# 项目目录名是纯中文，docker compose 无法从目录名推导合法 project name（净化后为空）。
# 固定为 rag：即旧中文目录名净化后的结果，容器/卷/网络归属不因目录改名而断。
COMPOSE_PROJECT_NAME=rag
